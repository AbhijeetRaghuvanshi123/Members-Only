<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <%- include('partials/errors.ejs') %>
    <form action="/user/joinclub" method="POST">
        <label for="passcode">Enter Club Passcode</label>
        <input type="password" name="passcode" id="passcode" value="<%= formData.passcode || '' %>">
        <button type="submit">Join Club</button>
    </form>
</body>
</html>