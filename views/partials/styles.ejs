<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background-color: #0f0f0f;
    color: #d4d0c8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .fortress-wrap {
    width: 100%;
    max-width: 480px;
  }

  .fortress-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .fortress-crest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 2px solid #c9a84c;
    background: #1a1a1a;
    margin-bottom: 1rem;
  }

  .fortress-crest svg {
    width: 30px;
    height: 30px;
    fill: #c9a84c;
  }

  .fortress-header h1 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c9a84c;
    margin-bottom: 4px;
  }

  .fortress-header .page-title {
    font-size: 22px;
    font-weight: 400;
    color: #e8e4d8;
    letter-spacing: 0.04em;
  }

  .fortress-card {
    background: #1a1a1a;
    border: 1px solid #2e2e2e;
    border-top: 3px solid #c9a84c;
    padding: 2rem;
  }

  .errors-list {
    border: 1px solid #5a2020;
    background: #1f0e0e;
    padding: 10px 14px;
    margin-bottom: 1.5rem;
    list-style: none;
  }

  .errors-list li {
    font-size: 13px;
    color: #e07070;
    padding: 3px 0;
    letter-spacing: 0.03em;
  }

  .errors-list li::before {
    content: '⚠ ';
    font-size: 11px;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 6px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    background: #111;
    border: 1px solid #2e2e2e;
    border-radius: 0;
    padding: 10px 12px;
    font-size: 14px;
    color: #e8e4d8;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #c9a84c;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #444;
  }

  .form-group textarea {
    height: 120px;
    resize: vertical;
  }

  .castle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: transparent;
    border: 1px solid #c9a84c;
    color: #c9a84c;
    padding: 11px 20px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    border-radius: 0;
    margin-top: 0.5rem;
    transition: background 0.15s, color 0.15s;
  }

  .castle-btn:hover {
    background: #c9a84c;
    color: #0f0f0f;
  }

  .castle-btn.danger {
    border-color: #a03030;
    color: #e07070;
  }

  .castle-btn.danger:hover {
    background: #a03030;
    color: #fff;
  }

  .footer-links {
    text-align: center;
    margin-top: 1.25rem;
    font-size: 12px;
    color: #555;
    letter-spacing: 0.04em;
  }

  .footer-links a {
    color: #c9a84c;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .divider {
    border: none;
    border-top: 1px solid #2e2e2e;
    margin: 1.5rem 0;
  }

  .corner-tl, .corner-tr, .corner-bl, .corner-br {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: #c9a84c;
    border-style: solid;
  }
  .corner-tl { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  .corner-tr { top: -1px; right: -1px; border-width: 2px 2px 0 0; }
  .corner-bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }
  .corner-br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
</style>