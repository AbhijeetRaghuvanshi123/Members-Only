<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Not Authenticated</title>
  <%- include('partials/styles.ejs') %>
</head>
<body>

  <div class="fortress-wrap">
    <div class="fortress-header">
      <div class="fortress-crest" style="border-color:#555;">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill:#555;">
          <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
      </div>
      <p class="page-title" style="color:#888;">Fortress Gates Closed</p>
      <h1 style="color:#888; letter-spacing:0.14em;">Identity Unverified</h1>
    </div>

    <div class="fortress-card" style="border-top-color:#333; text-align:center; padding:2.5rem 2rem;">
      <p style="font-size:14px; color:#666; line-height:1.7; margin-bottom:2rem;">
        You have not presented your credentials at the gate.<br>
        Entry to the fortress is forbidden without verification.
      </p>

      <a href="/user/login" style="text-decoration:none;">
        <button class="castle-btn" style="width:auto; padding:11px 32px; margin:0 auto;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
          Approach the Gate
        </button>
      </a>
    </div>

    <p class="footer-links">No credentials? &nbsp;<a href="/user/signup">Enlist here →</a></p>
  </div>

</body>
</html>